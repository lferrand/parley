.env.local
.venv/
deploy/__pycache__/
__pycache__/
desktop/node_modules/
desktop/dist/
research/

# Vendored native runtimes.
#
# These are build inputs, not source: ~29 MB of macOS dylibs, ~84 MB of Windows
# DLLs, a 130 MB ffmpeg.exe, and a 7 MB NSIS toolset. Committing them would put
# 250 MB of binaries in history that no diff can review and that must be
# re-downloaded wholesale on every version bump.
#
# The trade-off is real: a fresh clone cannot run `npm run dist:win` until the
# runtimes are restored. README, Desktop app -> Windows -> "Restoring the
# Windows build inputs", lists the exact URLs and versions.
#
# Ignore the folder contents rather than the folder, so the `.gitkeep` markers
# keeping the directory structure still track.
desktop/vendor/llama/*.dylib
desktop/vendor/llama/llama-server
desktop/vendor/llama-win/*
desktop/vendor/ffmpeg-win/*
desktop/vendor/nsis-native/*

!desktop/vendor/llama-win/.gitkeep
!desktop/vendor/ffmpeg-win/.gitkeep
!desktop/vendor/nsis-native/.gitkeep

# macOS Finder metadata. Never source, always noise.
.DS_Store
**/.DS_Store
